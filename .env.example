# Base mainnet demo (copy to .env; never commit .env)
BASE_RPC=https://mainnet.base.org
DEPLOYER_PK=0x...   # deploys router + hook + pool, seeds the hook float, runs keeper sweeps
MAKER1_PK=0x...     # alice
MAKER2_PK=0x...     # bob
MAKER3_PK=0x...     # carol
TRADER_PK=0x...     # optional: a wallet to make demo swaps from
# tiny demo sizes (raw token units). Makers must already hold WETH / USDC / cbBTC on Base.
FLOAT_USDC=2000000              # $2 of USDC working float in the hook
FLOAT_WETH=500000000000000      # 0.0005 WETH working float
